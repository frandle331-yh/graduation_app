<% if template.errors.any? %>
  <div class="form-errors">
    <p class="form-errors__title">⚠️ <%= template.errors.count %>件のエラーがあります</p>
    <ul>
      <% template.errors.full_messages.each do |m| %>
        <li><%= m %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: template, class: "form-card" do |f| %>
  <div class="form-group">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-input", placeholder: "例：洗濯、掃除機かけ、ゴミ出し" %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :category, class: "form-label" %>
      <%= f.select :category,
          HouseworkTemplate.categories.keys.map { |k| [t("enums.housework_log.category.#{k}"), k] },
          { include_blank: "選択してください" },
          class: "form-select" %>
    </div>

    <div class="form-group">
      <%= f.label :minutes, class: "form-label" %>
      <div class="form-input-suffix">
        <%= f.number_field :minutes, min: 0, max: 1440, step: 1,
              class: "form-input", placeholder: "30" %>
        <span class="form-suffix">分</span>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "キャンセル", housework_templates_path, class: "btn btn-ghost" %>
  </div>
<% end %>
