<div class="dashboard">

  <%# ---- 世帯なしの案内 ---- %>
  <% if @household.nil? %>
    <div class="household-cta">
      <div class="household-cta__icon">👨‍👩‍👧‍👦</div>
      <h2 class="household-cta__title">パートナーと一緒に使おう</h2>
      <p class="household-cta__desc">世帯を作成すると、<strong>貢献度の比較</strong>や<strong>ありがとうリアクション</strong>が使えます</p>
      <div class="household-cta__actions">
        <%= link_to "世帯を作成する", new_household_path, class: "btn btn-primary btn-sm" %>
        <%= link_to "招待コードで参加", join_household_path, class: "btn btn-secondary btn-sm" %>
      </div>
    </div>
  <% else %>
    <p class="dashboard-household">🏠 <strong><%= @household.name %></strong></p>
  <% end %>

  <%# ---- ストリーク + 今週の記録 ---- %>
  <div class="streak-bar">
    <div class="streak-bar__item">
      <span class="streak-bar__icon"><%= @presenter.streak >= 3 ? "🔥" : (@presenter.streak >= 1 ? "✨" : "💤") %></span>
      <div class="streak-bar__body">
        <span class="streak-bar__value"><%= @presenter.streak %><span class="streak-bar__unit">日</span></span>
        <span class="streak-bar__label">連続記録中</span>
      </div>
    </div>
    <div class="streak-bar__divider"></div>
    <div class="streak-bar__item">
      <span class="streak-bar__icon">📅</span>
      <div class="streak-bar__body">
        <span class="streak-bar__value"><%= @presenter.weekly_log_days %><span class="streak-bar__unit">日</span></span>
        <span class="streak-bar__label">今週の記録日</span>
      </div>
    </div>
    <% if @presenter.streak >= 7 %>
      <div class="streak-bar__badge">🏆 7日達成！</div>
    <% elsif @presenter.streak >= 3 %>
      <div class="streak-bar__badge">⚡ 絶好調！</div>
    <% end %>
  </div>

  <%# ---- 週次サマリーカード ---- %>
  <% weekly = @presenter.weekly_summary %>
  <div class="weekly-summary">
    <h2 class="weekly-summary__title">📊 今週のまとめ</h2>
    <div class="weekly-summary__grid">
      <div class="weekly-summary__stat">
        <span class="weekly-summary__stat-value"><%= weekly[:count] %><span class="weekly-summary__stat-unit">回</span></span>
        <span class="weekly-summary__stat-label">記録数</span>
        <% diff_count = weekly[:count] - weekly[:last_count] %>
        <span class="weekly-summary__trend <%= diff_count >= 0 ? 'weekly-summary__trend--up' : 'weekly-summary__trend--down' %>">
          <%= diff_count >= 0 ? "+" : "" %><%= diff_count %> 前週比
        </span>
      </div>
      <div class="weekly-summary__stat">
        <span class="weekly-summary__stat-value"><%= weekly[:minutes] %><span class="weekly-summary__stat-unit">分</span></span>
        <span class="weekly-summary__stat-label">合計時間</span>
        <% diff_min = weekly[:minutes] - weekly[:last_minutes] %>
        <span class="weekly-summary__trend <%= diff_min >= 0 ? 'weekly-summary__trend--up' : 'weekly-summary__trend--down' %>">
          <%= diff_min >= 0 ? "+" : "" %><%= diff_min %>分 前週比
        </span>
      </div>
      <div class="weekly-summary__stat">
        <span class="weekly-summary__stat-value"><%= weekly[:avg_minutes_per_day] %><span class="weekly-summary__stat-unit">分</span></span>
        <span class="weekly-summary__stat-label">1日あたり平均</span>
      </div>
      <div class="weekly-summary__stat">
        <% if weekly[:top_category] %>
          <span class="weekly-summary__stat-value"><%= category_icon(weekly[:top_category]) %></span>
          <span class="weekly-summary__stat-label">よくやった家事</span>
          <span class="weekly-summary__stat-sub"><%= t("enums.housework_log.category.#{weekly[:top_category]}") %></span>
        <% else %>
          <span class="weekly-summary__stat-value">-</span>
          <span class="weekly-summary__stat-label">よくやった家事</span>
        <% end %>
      </div>
    </div>
    <% if weekly[:count] == 0 %>
      <p class="weekly-summary__message">今週はまだ記録がありません。最初の一歩を踏み出しましょう！</p>
    <% elsif weekly[:count] >= 10 %>
      <p class="weekly-summary__message">🎉 今週もたくさんの家事をこなしています！素晴らしい！</p>
    <% elsif diff_count > 0 %>
      <p class="weekly-summary__message">📈 先週より<%= diff_count %>回多く記録しています。この調子！</p>
    <% end %>
  </div>

  <%# ---- クイック記録（テンプレートから1タップ） ---- %>
  <div class="quick-record">
    <div class="quick-record__header">
      <span class="quick-record__title">⚡ クイック記録</span>
      <%= link_to "管理 →", housework_templates_path, class: "quick-record__manage" %>
    </div>
    <% if @quick_templates.present? %>
      <div class="quick-record__grid">
        <% @quick_templates.each do |tmpl| %>
          <%= button_to use_housework_template_path(tmpl), method: :post,
                class: "quick-btn quick-btn--#{tmpl.category}" do %>
            <span class="quick-btn__icon"><%= category_icon(tmpl.category) %></span>
            <span class="quick-btn__title"><%= tmpl.title %></span>
            <% if tmpl.minutes.present? %>
              <span class="quick-btn__min"><%= tmpl.minutes %>分</span>
            <% end %>
          <% end %>
        <% end %>
        <%# 新規ログボタン %>
        <%= link_to new_housework_log_path, class: "quick-btn quick-btn--new" do %>
          <span class="quick-btn__icon">✏️</span>
          <span class="quick-btn__title">手動で記録</span>
        <% end %>
      </div>
    <% else %>
      <div class="quick-record__empty">
        <p>テンプレートを登録すると、ここから1タップで記録できます。</p>
        <div class="quick-record__empty-actions">
          <%= link_to "テンプレートを追加する", new_housework_template_path, class: "btn btn-primary btn-sm" %>
          <%= link_to "手動で記録", new_housework_log_path, class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>

  <%# ---- 直近の記録からワンタップ再記録 ---- %>
  <% if @recent_logs.present? %>
    <div class="recent-record">
      <div class="recent-record__header">
        <span class="recent-record__title">🕐 最近の記録をもう一度</span>
        <%= link_to "一覧 →", housework_logs_path, class: "recent-record__link" %>
      </div>
      <div class="recent-record__list">
        <% @recent_logs.each do |log| %>
          <%= button_to quick_create_housework_logs_path(source_id: log.id), method: :post,
                class: "recent-btn" do %>
            <span class="recent-btn__icon"><%= category_icon(log.category) %></span>
            <span class="recent-btn__body">
              <span class="recent-btn__title"><%= log.title %></span>
              <span class="recent-btn__meta"><%= log.minutes %>分</span>
            </span>
            <span class="recent-btn__action">+</span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ---- 期間切り替え ---- %>
  <nav class="period-nav">
    <% [["week", "今週"], ["month", "今月"], ["all", "全期間"]].each do |value, label| %>
      <%= link_to label, dashboard_path(period: value),
            class: "period-nav__btn #{"period-nav__btn--active" if @presenter.period == value}" %>
    <% end %>
  </nav>

  <%# ---- サマリーカード ---- %>
  <div class="dashboard-summary">
    <div class="summary-card">
      <span class="summary-card__label">合計時間</span>
      <span class="summary-card__value"><%= @presenter.total_minutes %><span class="summary-card__unit">分</span></span>
    </div>
    <div class="summary-card">
      <span class="summary-card__label">記録回数</span>
      <span class="summary-card__value"><%= @presenter.total_count %><span class="summary-card__unit">回</span></span>
    </div>
  </div>

  <%# ---- グラフ2カラム ---- %>
  <div class="chart-grid">

    <%# -- 日別棒グラフ -- %>
    <div class="chart-card">
      <h2 class="chart-card__title">日別推移（分）</h2>
      <% if @presenter.daily_summaries.present? %>
        <div data-controller="chart"
             data-chart-type-value="bar"
             data-chart-labels-value="<%= @presenter.daily_summaries.keys.map { |d| l(d, format: :short) rescue d.to_s }.to_json %>"
             data-chart-data-value="<%= @presenter.daily_summaries.values.to_json %>">
          <canvas data-chart-target="canvas" height="220"></canvas>
        </div>
      <% else %>
        <p class="chart-empty">データがありません</p>
      <% end %>
    </div>

    <%# -- カテゴリ円グラフ -- %>
    <div class="chart-card">
      <h2 class="chart-card__title">カテゴリ別（分）</h2>
      <% if @presenter.category_summaries.present? %>
        <div data-controller="chart"
             data-chart-type-value="doughnut"
             data-chart-labels-value="<%= @presenter.category_summaries.map { |k, _|
               category_key = k.is_a?(String) ? k : HouseworkLog.categories.key(k)
               t("enums.housework_log.category.#{category_key}")
             }.to_json %>"
             data-chart-data-value="<%= @presenter.category_summaries.values.to_json %>"
             data-chart-legend-value="true">
          <canvas data-chart-target="canvas" height="220"></canvas>
        </div>
      <% else %>
        <p class="chart-empty">データがありません</p>
      <% end %>
    </div>

    <%# -- 貢献バランスバー（世帯あり） -- %>
    <% contrib = @presenter.contribution %>
    <% if contrib %>
      <div class="chart-card contribution-card">
        <h2 class="chart-card__title">⚖️ 貢献バランス</h2>
        <%
          users_arr  = contrib[:minutes_by_user].to_a
          colors     = %w[#6384FF #FF6384 #FFCE56 #4BC0C0]
        %>

        <%# 2人の場合: 左右の分割バー %>
        <% if users_arr.size == 2 %>
          <% user_a, min_a = users_arr[0]; user_b, min_b = users_arr[1] %>
          <% rate_a = contrib[:rates_by_user][user_a]; rate_b = contrib[:rates_by_user][user_b] %>
          <div class="balance-names">
            <span class="balance-names__left"><%= user_a&.nickname.presence || user_a&.email || "メンバー" %></span>
            <span class="balance-names__right"><%= user_b&.nickname.presence || user_b&.email || "メンバー" %></span>
          </div>
          <div class="balance-bar">
            <div class="balance-bar__fill balance-bar__fill--a" style="width: <%= rate_a %>%"></div>
            <div class="balance-bar__fill balance-bar__fill--b" style="width: <%= rate_b %>%"></div>
          </div>
          <div class="balance-rates">
            <span class="balance-rates__left"><%= min_a %>分 (<%= rate_a %>%)</span>
            <span class="balance-rates__right"><%= min_b %>分 (<%= rate_b %>%)</span>
          </div>
          <% diff = (rate_a - rate_b).abs.round(1) %>
          <p class="balance-comment">
            <% if diff < 5 %>
              🤝 とてもバランスが取れています！
            <% elsif rate_a > rate_b %>
              <%= user_a&.nickname.presence || user_a&.email || "メンバー" %> さんが多く貢献中 💪
            <% else %>
              <%= user_b&.nickname.presence || user_b&.email || "メンバー" %> さんが多く貢献中 💪
            <% end %>
          </p>
        <%# 3人以上: リスト形式 %>
        <% else %>
          <div class="multi-bar">
            <% users_arr.each_with_index do |(user, minutes), i| %>
              <% rate = contrib[:rates_by_user][user] %>
              <div class="multi-bar__row">
                <span class="multi-bar__name"><%= user&.nickname.presence || user&.email || "メンバー" %></span>
                <div class="multi-bar__track">
                  <div class="multi-bar__fill" style="width: <%= rate %>%; background: <%= colors[i % colors.size] %>"></div>
                </div>
                <span class="multi-bar__value"><%= minutes %>分 (<%= rate %>%)</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>

  <%# ---- 月間カレンダー ---- %>
  <% cal = @presenter.calendar %>
  <div class="calendar-card">
    <h2 class="calendar-card__title">📅 <%= cal[:month_label] %></h2>
    <div class="calendar-grid">
      <% %w[月 火 水 木 金 土 日].each do |dow| %>
        <div class="calendar-grid__dow"><%= dow %></div>
      <% end %>
      <%# 月曜始まりで空セルを埋める %>
      <% wday_offset = (cal[:first].wday + 6) % 7 %>
      <% wday_offset.times do %>
        <div class="calendar-grid__cell calendar-grid__cell--empty"></div>
      <% end %>
      <% (cal[:first]..cal[:last]).each do |date| %>
        <% count = cal[:data][date] || 0 %>
        <div class="calendar-grid__cell
                    <%= 'calendar-grid__cell--today' if date == cal[:today] %>
                    <%= 'calendar-grid__cell--has-log' if count > 0 %>">
          <span class="calendar-grid__day"><%= date.day %></span>
          <% if count > 0 %>
            <span class="calendar-grid__dot"><%= count > 1 ? "#{count}" : "●" %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# ---- 達成バッジ ---- %>
  <div class="badges-section">
    <div class="badges-section__header">
      <h2 class="badges-section__title">🏅 達成バッジ</h2>
      <span class="badges-section__count"><%= @presenter.earned_badge_count %> / <%= @presenter.badges.size %> 獲得</span>
    </div>
    <div class="badges-section__progress">
      <div class="badges-section__progress-bar" style="width: <%= (@presenter.earned_badge_count.to_f / @presenter.badges.size * 100).round %>%"></div>
    </div>
    <div class="badges-grid">
      <% @presenter.badges.each do |badge| %>
        <div class="badge-item <%= 'badge-item--locked' unless badge[:earned] %>">
          <span class="badge-item__icon"><%= badge[:earned] ? badge[:icon] : "🔒" %></span>
          <span class="badge-item__title"><%= badge[:title] %></span>
          <span class="badge-item__desc"><%= badge[:description] %></span>
        </div>
      <% end %>
    </div>
  </div>

  <p class="dashboard-link">
    <%= link_to "家事ログ一覧を見る →", housework_logs_path %>
  </p>

</div>
