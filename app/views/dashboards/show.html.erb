<% if @household.nil? %>
  <h1>ダッシュボード</h1>
  <p>世帯を作成または参加すると、貢献度の可視化や分析が使えます。</p>

  <p>
    <%= link_to "世帯を作成する", new_household_path %> /
    <%= link_to "招待コードで参加する", join_household_path %>
  </p>

  <hr style="margin: 16px 0;">
  <p>※ いまは個人の家事ログを元に分析を表示しています。</p>
<% else %>
  <p><strong>世帯名：</strong><%= @household.name %></p>
<% end %>

<h2>今週の合計</h2>
<p><%= @weekly_total_minutes %> 分</p>

<% if @household && @weekly_minutes_by_user.present? %>
  <h2>メンバー別（今週）</h2>
  <ul>
    <% @weekly_minutes_by_user.each do |user, minutes| %>
      <li>
        <%= user.nickname.presence || user.email %>：
        <%= minutes %> 分（<%= @weekly_minutes_rates_by_user[user] %>%）
      </li>
    <% end %>
  </ul>
<% end %>


<h2>カテゴリ別（今週）</h2>
<ul>
  <% @category_summaries.each do |category_key_or_value, total_minutes| %>
    <% category_key =
         category_key_or_value.is_a?(String) ? category_key_or_value : HouseworkLog.categories.key(category_key_or_value) %>
    <li><%= t("enums.housework_log.category.#{category_key}") %>： <%= total_minutes %> 分</li>
  <% end %>
</ul>

<h2>直近7日（今週）</h2>
<ul>
  <% @daily_summaries.each do |date, total_minutes| %>
    <li><%= l(date) %>： <%= total_minutes %> 分</li>
  <% end %>
</ul>

<p style="margin-top: 16px;">
  <%= link_to "家事ログ一覧へ", housework_logs_path %>
</p>
