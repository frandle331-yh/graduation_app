<% unless @household %>
  <h1>ダッシュボード</h1>
  <p>世帯を作成または参加すると、貢献度の可視化や分析が使えます。</p>

  <p>
    <%= link_to "世帯を作成する", new_household_path %> /
    <%= link_to "招待コードで参加する", join_household_path %>
  </p>

  <p style="margin-top: 12px;">
    先に個人で記録したい方はこちら：
    <%= link_to "家事ログへ", housework_logs_path %>
  </p>
  <% return %>
<% end %>

<h1>ダッシュボード</h1>
<p><strong>世帯名：</strong><%= @household.name %></p>

<hr>

<h2>今週の貢献度（世帯）</h2>

<% if @weekly_total_count.zero? %>
  <p>今週の家事記録がありません。</p>
<% else %>
  <p>
    <strong>今週の総回数：</strong><%= @weekly_total_count %> 回 /
    <strong>時間：</strong><%= @weekly_total_minutes.to_i %> 分
  </p>

  <table border="1" cellpadding="8">
    <tr>
      <th>ユーザー</th>
      <th>回数</th>
      <th>回数割合</th>
      <th>時間</th>
      <th>時間割合</th>
    </tr>

    <% (@weekly_counts_by_user.keys | @weekly_minutes_by_user.keys).each do |user| %>
      <tr>
        <td><%= user.nickname.presence || user.email %></td>
        <td><%= @weekly_counts_by_user[user].to_i %> 回</td>
        <td><%= @weekly_count_rates_by_user[user].to_f %> %</td>
        <td><%= @weekly_minutes_by_user[user].to_i %> 分</td>
        <td><%= @weekly_minutes_rates_by_user[user].to_f %> %</td>
      </tr>
    <% end %>
  </table>
<% end %>

<hr>

<h2>あなたの今週</h2>
<p>
  <strong><%= @my_weekly_count %></strong> 回
  （<%= @my_weekly_minutes.to_i %> 分）
</p>

<h3>カテゴリ別（今週）</h3>
<% if @my_category_counts.blank? %>
  <p>今週のカテゴリ集計がありません。</p>
<% else %>
  <ul>
    <% @my_category_counts.each do |category, count| %>
      <% minutes = @my_category_minutes[category].to_i %>
      <li>
        <%= HouseworkLog.category_label(category) %>：<strong><%= count %></strong> 回（<%= minutes %> 分）
      </li>
    <% end %>
  </ul>
<% end %>

<h3>直近7日</h3>
<% if @my_daily_counts.blank? %>
  <p>直近7日の記録がありません。</p>
<% else %>
  <ul>
    <% @my_daily_counts.each do |date, count| %>
      <% minutes = @my_daily_minutes[date].to_i %>
      <li>
        <%= date %>：<strong><%= count %></strong> 回（<%= minutes %> 分）
      </li>
    <% end %>
  </ul>
<% end %>
