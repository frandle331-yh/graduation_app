<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<% end %>

<div class="dashboard">

  <%# ---- 世帯なしの案内 ---- %>
  <% if @household.nil? %>
    <div class="dashboard-notice">
      <p>世帯を作成またはパートナーの招待コードで参加すると、<strong>ふたりの貢献度比較</strong>が使えます。</p>
      <div class="dashboard-notice__actions">
        <%= link_to "世帯を作成する", new_household_path %>
        <%= link_to "招待コードで参加する", join_household_path %>
      </div>
    </div>
  <% else %>
    <p class="dashboard-household">🏠 <strong><%= @household.name %></strong></p>
  <% end %>

  <%# ---- ストリーク + 今週の記録 ---- %>
  <div class="streak-bar">
    <div class="streak-bar__item">
      <span class="streak-bar__icon"><%= @streak >= 3 ? "🔥" : (@streak >= 1 ? "✨" : "💤") %></span>
      <div class="streak-bar__body">
        <span class="streak-bar__value"><%= @streak %><span class="streak-bar__unit">日</span></span>
        <span class="streak-bar__label">連続記録中</span>
      </div>
    </div>
    <div class="streak-bar__divider"></div>
    <div class="streak-bar__item">
      <span class="streak-bar__icon">📅</span>
      <div class="streak-bar__body">
        <span class="streak-bar__value"><%= @weekly_log_days %><span class="streak-bar__unit">日</span></span>
        <span class="streak-bar__label">今週の記録日</span>
      </div>
    </div>
    <% if @streak >= 7 %>
      <div class="streak-bar__badge">🏆 7日達成！</div>
    <% elsif @streak >= 3 %>
      <div class="streak-bar__badge">⚡ 絶好調！</div>
    <% end %>
  </div>

  <%# ---- クイック記録（テンプレートから1タップ） ---- %>
  <div class="quick-record">
    <div class="quick-record__header">
      <span class="quick-record__title">⚡ クイック記録</span>
      <%= link_to "管理 →", housework_templates_path, class: "quick-record__manage" %>
    </div>
    <% if @quick_templates.present? %>
      <div class="quick-record__grid">
        <% @quick_templates.each do |tmpl| %>
          <%= button_to use_housework_template_path(tmpl), method: :post,
                class: "quick-btn quick-btn--#{tmpl.category}" do %>
            <span class="quick-btn__icon"><%= category_icon(tmpl.category) %></span>
            <span class="quick-btn__title"><%= tmpl.title %></span>
            <% if tmpl.minutes.present? %>
              <span class="quick-btn__min"><%= tmpl.minutes %>分</span>
            <% end %>
          <% end %>
        <% end %>
        <%# 新規ログボタン %>
        <%= link_to new_housework_log_path, class: "quick-btn quick-btn--new" do %>
          <span class="quick-btn__icon">✏️</span>
          <span class="quick-btn__title">手動で記録</span>
        <% end %>
      </div>
    <% else %>
      <div class="quick-record__empty">
        <p>テンプレートを登録すると、ここから1タップで記録できます。</p>
        <div class="quick-record__empty-actions">
          <%= link_to "テンプレートを追加する", new_housework_template_path, class: "btn btn-primary btn-sm" %>
          <%= link_to "手動で記録", new_housework_log_path, class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>

  <%# ---- 期間切り替え ---- %>
  <nav class="period-nav">
    <% [["week", "今週"], ["month", "今月"], ["all", "全期間"]].each do |value, label| %>
      <%= link_to label, dashboard_path(period: value),
            class: "period-nav__btn #{"period-nav__btn--active" if @period == value}" %>
    <% end %>
  </nav>

  <%# ---- サマリーカード ---- %>
  <div class="dashboard-summary">
    <div class="summary-card">
      <span class="summary-card__label">合計時間</span>
      <span class="summary-card__value"><%= @total_minutes %><span class="summary-card__unit">分</span></span>
    </div>
    <div class="summary-card">
      <span class="summary-card__label">記録回数</span>
      <span class="summary-card__value"><%= @total_count %><span class="summary-card__unit">回</span></span>
    </div>
  </div>

  <%# ---- グラフ2カラム ---- %>
  <div class="chart-grid">

    <%# -- 日別棒グラフ -- %>
    <div class="chart-card">
      <h2 class="chart-card__title">日別推移（分）</h2>
      <% if @daily_summaries.present? %>
        <canvas id="dailyChart" height="220"></canvas>
        <script>
          new Chart(document.getElementById("dailyChart"), {
            type: "bar",
            data: {
              labels: <%= raw json_escape(@daily_summaries.keys.map { |d| l(d, format: :short) rescue d.to_s }.to_json) %>,
              datasets: [{
                label: "所要時間（分）",
                data: <%= raw json_escape(@daily_summaries.values.to_json) %>,
                backgroundColor: "rgba(99, 132, 255, 0.7)",
                borderRadius: 4
              }]
            },
            options: {
              responsive: true,
              plugins: { legend: { display: false } },
              scales: { y: { beginAtZero: true } }
            }
          });
        </script>
      <% else %>
        <p class="chart-empty">データがありません</p>
      <% end %>
    </div>

    <%# -- カテゴリ円グラフ -- %>
    <div class="chart-card">
      <h2 class="chart-card__title">カテゴリ別（分）</h2>
      <% if @category_summaries.present? %>
        <canvas id="categoryChart" height="220"></canvas>
        <script>
          new Chart(document.getElementById("categoryChart"), {
            type: "doughnut",
            data: {
              labels: <%= raw json_escape(@category_summaries.map { |k, _|
                category_key = k.is_a?(String) ? k : HouseworkLog.categories.key(k)
                t("enums.housework_log.category.#{category_key}")
              }.to_json) %>,
              datasets: [{
                data: <%= raw json_escape(@category_summaries.values.to_json) %>,
                backgroundColor: [
                  "#6384FF","#FF6384","#FFCE56","#4BC0C0","#9966FF","#FF9F40","#C9CBCF"
                ]
              }]
            },
            options: {
              responsive: true,
              plugins: {
                legend: { position: "bottom" }
              }
            }
          });
        </script>
      <% else %>
        <p class="chart-empty">データがありません</p>
      <% end %>
    </div>

    <%# -- 貢献バランスバー（世帯あり） -- %>
    <% if @household && @minutes_by_user.present? %>
      <div class="chart-card contribution-card">
        <h2 class="chart-card__title">⚖️ 貢献バランス</h2>
        <%
          users_arr  = @minutes_by_user.to_a  # [[user, minutes], ...]
          colors     = %w[#6384FF #FF6384 #FFCE56 #4BC0C0]
          me         = users_arr.find { |u, _| u.id == current_user.id }
          others     = users_arr.reject { |u, _| u.id == current_user.id }
          my_rate    = me ? @rates_by_user[me.first] : 0
          total_min  = @total_minutes.to_i
        %>

        <%# 2人の場合: 左右の分割バー %>
        <% if users_arr.size == 2 %>
          <% user_a, min_a = users_arr[0]; user_b, min_b = users_arr[1] %>
          <% rate_a = @rates_by_user[user_a]; rate_b = @rates_by_user[user_b] %>
          <div class="balance-names">
            <span class="balance-names__left"><%= user_a.nickname.presence || user_a.email %></span>
            <span class="balance-names__right"><%= user_b.nickname.presence || user_b.email %></span>
          </div>
          <div class="balance-bar">
            <div class="balance-bar__fill balance-bar__fill--a" style="width: <%= rate_a %>%"></div>
            <div class="balance-bar__fill balance-bar__fill--b" style="width: <%= rate_b %>%"></div>
          </div>
          <div class="balance-rates">
            <span class="balance-rates__left"><%= min_a %>分 (<%= rate_a %>%)</span>
            <span class="balance-rates__right"><%= min_b %>分 (<%= rate_b %>%)</span>
          </div>
          <% diff = (rate_a - rate_b).abs.round(1) %>
          <p class="balance-comment">
            <% if diff < 5 %>
              🤝 とてもバランスが取れています！
            <% elsif rate_a > rate_b %>
              <%= user_a.nickname.presence || user_a.email %> さんが多く貢献中 💪
            <% else %>
              <%= user_b.nickname.presence || user_b.email %> さんが多く貢献中 💪
            <% end %>
          </p>
        <%# 3人以上: リスト形式 %>
        <% else %>
          <div class="multi-bar">
            <% users_arr.each_with_index do |(user, minutes), i| %>
              <% rate = @rates_by_user[user] %>
              <div class="multi-bar__row">
                <span class="multi-bar__name"><%= user.nickname.presence || user.email %></span>
                <div class="multi-bar__track">
                  <div class="multi-bar__fill" style="width: <%= rate %>%; background: <%= colors[i % colors.size] %>"></div>
                </div>
                <span class="multi-bar__value"><%= minutes %>分 (<%= rate %>%)</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>

  <p class="dashboard-link">
    <%= link_to "家事ログ一覧を見る →", housework_logs_path %>
  </p>

</div>

