<header class="app-header">
  <div class="app-nav">
    <%= link_to "Home", root_path, class: "app-logo" %>

    <nav class="app-nav-links">

      <%= link_to "家事ログ", housework_logs_path %>

      <% if user_signed_in? %>
        <span class="app-user">
          <%= current_user.nickname.presence || "User" %>
        </span>

        <% if respond_to?(:edit_profile_path) %>
          <%= link_to "プロフィール", edit_profile_path %>
        <% end %>

        <%= button_to "ログアウト",
              destroy_user_session_path,
              method: :delete,
              form: { class: "inline-form" } %>
      <% else %>
        <%= link_to "ログイン", new_user_session_path %>
        <%= link_to "新規登録", new_user_registration_path %>
      <% end %>
    </nav>
  </div>
</header>
