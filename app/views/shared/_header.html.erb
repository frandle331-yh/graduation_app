<header class="app-header" data-controller="hamburger theme">
  <div class="app-nav">
    <%= link_to "KajiMate", root_path, class: "app-logo" %>

    <%# デスクトップ用ナビ %>
    <nav class="app-nav-links">
      <% if user_signed_in? %>
        <%= link_to "ダッシュボード", dashboard_path %>
        <%= link_to "家事ログ", housework_logs_path %>
        <%= link_to "テンプレート", housework_templates_path %>
        <% if current_household %>
          <%= link_to "タイムライン", timeline_household_path %>
          <%= link_to "世帯", household_path %>
        <% else %>
          <%= link_to "世帯", new_household_path %>
        <% end %>
        <%= link_to "家事を記録", new_housework_log_path, class: "app-nav-primary" %>
        <button class="theme-toggle" data-action="theme#toggle" aria-label="テーマ切替">
          <span data-theme-target="icon">🌓</span>
        </button>
        <div class="app-nav-user">
          <%= link_to current_user.nickname.presence || "User", profile_path, class: "app-user" %>
          <%= button_to "ログアウト",
                destroy_user_session_path,
                method: :delete,
                form: { class: "inline-form" } %>
        </div>
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "app-nav-primary" %>
        <%= link_to "新規登録", new_user_registration_path, class: "app-nav-secondary" %>
      <% end %>
    </nav>

    <%# ハンバーガーボタン（モバイル・ボトムナビが使えない場合のフォールバック） %>
    <button class="nav-hamburger"
            aria-label="メニューを開く"
            data-action="click->hamburger#toggle"
            data-hamburger-target="button">
      <span class="nav-hamburger__line"></span>
      <span class="nav-hamburger__line"></span>
      <span class="nav-hamburger__line"></span>
    </button>
  </div>

  <%# モバイル用ドロワーメニュー（ハンバーガー時のみ表示） %>
  <nav class="nav-drawer" data-hamburger-target="drawer">
    <% if user_signed_in? %>
      <%= link_to "ダッシュボード", dashboard_path, data: { action: "click->hamburger#close" } %>
      <%= link_to "家事ログ", housework_logs_path, data: { action: "click->hamburger#close" } %>
      <%= link_to "テンプレート", housework_templates_path, data: { action: "click->hamburger#close" } %>
      <% if current_household %>
        <%= link_to "タイムライン", timeline_household_path, data: { action: "click->hamburger#close" } %>
        <%= link_to "世帯", household_path, data: { action: "click->hamburger#close" } %>
      <% else %>
        <%= link_to "世帯を作成", new_household_path, data: { action: "click->hamburger#close" } %>
      <% end %>
      <%= link_to "家事を記録", new_housework_log_path, class: "nav-drawer__cta",
            data: { action: "click->hamburger#close" } %>
      <button class="theme-toggle" data-action="theme#toggle" style="margin: 8px 0;">
        <span data-theme-target="icon">🌓</span> テーマ切替
      </button>
      <%= button_to "ログアウト",
            destroy_user_session_path,
            method: :delete,
            form: { class: "inline-form" } %>
    <% else %>
      <%= link_to "ログイン", new_user_session_path, data: { action: "click->hamburger#close" } %>
      <%= link_to "新規登録", new_user_registration_path, class: "nav-drawer__cta",
            data: { action: "click->hamburger#close" } %>
    <% end %>
  </nav>
</header>

<%# モバイル用ボトムナビゲーション（スマホのみ表示） %>
<% if user_signed_in? %>
  <nav class="bottom-nav" aria-label="ボトムナビゲーション">
    <div class="bottom-nav__inner">
      <%= link_to dashboard_path,
            class: "bottom-nav__item#{' active' if current_page?(dashboard_path)}" do %>
        <span class="bottom-nav__icon">📊</span>
        <span class="bottom-nav__label">ダッシュ</span>
      <% end %>
      <%= link_to housework_logs_path,
            class: "bottom-nav__item#{' active' if request.path.start_with?('/housework_logs')}" do %>
        <span class="bottom-nav__icon">📋</span>
        <span class="bottom-nav__label">ログ</span>
      <% end %>
      <%= link_to new_housework_log_path, class: "bottom-nav__item bottom-nav__item--cta" do %>
        <span class="bottom-nav__icon-wrap">＋</span>
        <span class="bottom-nav__label">記録</span>
      <% end %>
      <%= link_to housework_templates_path,
            class: "bottom-nav__item#{' active' if request.path.start_with?('/housework_templates')}" do %>
        <span class="bottom-nav__icon">⚡</span>
        <span class="bottom-nav__label">テンプレ</span>
      <% end %>
      <% if current_household %>
        <%= link_to household_path,
              class: "bottom-nav__item#{' active' if request.path.start_with?('/household')}" do %>
          <span class="bottom-nav__icon">👫</span>
          <span class="bottom-nav__label">世帯</span>
        <% end %>
      <% else %>
        <%= link_to new_household_path,
              class: "bottom-nav__item#{' active' if current_page?(new_household_path)}" do %>
          <span class="bottom-nav__icon">🏠</span>
          <span class="bottom-nav__label">世帯</span>
        <% end %>
      <% end %>
    </div>
  </nav>
<% end %>
