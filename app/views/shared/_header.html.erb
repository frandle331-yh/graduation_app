<header class="app-header" data-controller="hamburger">
  <div class="app-nav">
    <%= link_to "KajiMate", root_path, class: "app-logo" %>

    <%# デスクトップ用ナビ %>
    <nav class="app-nav-links">
      <% if user_signed_in? %>
        <%= link_to "ダッシュボード", dashboard_path %>
        <%= link_to "家事ログ", housework_logs_path %>
        <%= link_to "テンプレート", housework_templates_path %>
        <% if current_household %>
          <%= link_to "世帯", household_path %>
        <% else %>
          <%= link_to "世帯", new_household_path %>
        <% end %>
        <%= link_to "家事を記録", new_housework_log_path, class: "app-nav-primary" %>
        <div class="app-nav-user">
          <span class="app-user"><%= current_user.nickname.presence || "User" %></span>
          <%= button_to "ログアウト",
                destroy_user_session_path,
                method: :delete,
                form: { class: "inline-form" } %>
        </div>
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "app-nav-primary" %>
        <%= link_to "新規登録", new_user_registration_path, class: "app-nav-secondary" %>
      <% end %>
    </nav>

    <%# ハンバーガーボタン（モバイルのみ表示） %>
    <button class="nav-hamburger"
            aria-label="メニューを開く"
            data-action="click->hamburger#toggle"
            data-hamburger-target="button">
      <span class="nav-hamburger__line"></span>
      <span class="nav-hamburger__line"></span>
      <span class="nav-hamburger__line"></span>
    </button>
  </div>

  <%# モバイル用ドロワーメニュー %>
  <nav class="nav-drawer" data-hamburger-target="drawer">
    <% if user_signed_in? %>
      <%= link_to "ダッシュボード", dashboard_path, data: { action: "click->hamburger#close" } %>
      <%= link_to "家事ログ", housework_logs_path, data: { action: "click->hamburger#close" } %>
      <%= link_to "テンプレート", housework_templates_path, data: { action: "click->hamburger#close" } %>
      <% if current_household %>
        <%= link_to "世帯", household_path, data: { action: "click->hamburger#close" } %>
      <% else %>
        <%= link_to "世帯を作成", new_household_path, data: { action: "click->hamburger#close" } %>
      <% end %>
      <%= link_to "家事を記録", new_housework_log_path, class: "nav-drawer__cta",
            data: { action: "click->hamburger#close" } %>
      <%= button_to "ログアウト",
            destroy_user_session_path,
            method: :delete,
            form: { class: "inline-form" } %>
    <% else %>
      <%= link_to "ログイン", new_user_session_path, data: { action: "click->hamburger#close" } %>
      <%= link_to "新規登録", new_user_registration_path, class: "nav-drawer__cta",
            data: { action: "click->hamburger#close" } %>
    <% end %>
  </nav>
</header>
