<div class="page-header">
  <h1 class="page-title">世帯</h1>
</div>

<%# ---- 世帯情報カード ---- %>
<div class="card">
  <div class="card__body">
    <h2 class="section-title" style="margin-bottom: 12px;">🏠 <%= @household.name %></h2>

    <%# 招待コード ---- %>
    <div class="invite-code-block" data-controller="clipboard">
      <p class="invite-code-block__label">招待コード（パートナーに共有）</p>
      <div class="invite-code-block__row">
        <code class="invite-code-block__code" data-clipboard-target="source"><%= @household.invitation_code %></code>
        <button class="btn btn-secondary btn-sm invite-code-block__copy"
                type="button"
                data-clipboard-target="button"
                data-action="clipboard#copy">
          コピー
        </button>
      </div>
      <p class="invite-code-block__hint">パートナーがこのコードを「招待コードで参加する」から入力すると世帯が共有されます。</p>
    </div>

    <%# 共有ボタン %>
    <% share_text = "KajiMateで一緒に家事を記録しよう！招待コード: #{@household.invitation_code}" %>
    <div class="share-buttons">
      <a href="https://line.me/R/msg/text/?<%= ERB::Util.url_encode(share_text) %>"
         target="_blank" rel="noopener noreferrer"
         class="share-btn share-btn--line">
        <span class="share-btn__icon">💬</span>
        LINEで送る
      </a>
      <button type="button" class="share-btn share-btn--native" style="display:none;"
              data-controller="web-share"
              data-web-share-title-value="KajiMate 招待"
              data-web-share-text-value="<%= share_text %>"
              data-action="web-share#share">
        <span class="share-btn__icon">📤</span>
        共有する
      </button>
    </div>
  </div>
</div>

<%# ---- メンバー一覧 ---- %>
<div class="section-header" style="margin-top: 24px;">
  <h2 class="section-title">メンバー（<%= @members.size %>人）</h2>
</div>

<ul class="member-card-list">
  <% @members.each do |m| %>
    <li class="member-card">
      <div class="member-card__avatar">
        <%= (m.user.nickname.presence || m.user.email).first %>
      </div>
      <div class="member-card__info">
        <strong class="member-card__name"><%= m.user.nickname.presence || m.user.email %></strong>
        <span class="member-card__role member-card__role--<%= m.role %>">
          <%= t("enums.household_member.role.#{m.role}") %>
        </span>
      </div>
    </li>
  <% end %>
</ul>

<p class="page-link-bottom">
  <%= link_to "ダッシュボードで貢献度を確認 →", dashboard_path %>
</p>
