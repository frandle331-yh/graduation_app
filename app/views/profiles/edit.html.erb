<div class="profile-page">
  <div class="page-header">
    <h1 class="page-title">プロフィール編集</h1>
    <%= link_to "マイページに戻る", profile_path, class: "btn btn-secondary btn-sm" %>
  </div>

  <% if @user.errors.any? %>
    <div class="error-box">
      <p><%= @user.errors.count %>件のエラーがあります</p>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="profile-section">
    <h2 class="profile-section__title">基本情報</h2>
    <%= form_with model: @user, url: profile_path, method: :patch, class: "form-card" do |f| %>
      <div class="form-group">
        <%= f.label :nickname, "ニックネーム", class: "form-label" %>
        <%= f.text_field :nickname, class: "form-input", maxlength: 20 %>
        <% if @user.errors[:nickname].present? %>
          <div class="field-error"><%= @user.errors.full_messages_for(:nickname).first %></div>
        <% end %>
      </div>
      <div class="form-actions">
        <%= f.submit "更新する", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="profile-section danger-section">
    <h2 class="profile-section__title" style="color: var(--danger);">退会</h2>
    <p class="danger-section__text">退会するとログインできなくなります。この操作は取り消せません。</p>
    <%= button_to "退会する",
          profile_path,
          method: :delete,
          class: "btn btn-danger btn-sm",
          data: { turbo_confirm: "本当に退会しますか？この操作は取り消せません。" } %>
  </div>
</div>
