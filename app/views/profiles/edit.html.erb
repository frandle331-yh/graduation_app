<h1>プロフィール編集</h1>

<% if @user.errors.any? %>
  <div class="form-errors">
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: profile_path, method: :patch do |f| %>
  <div class="field">
    <p><%= f.label :nickname, "ニックネーム" %></p>
    <p><%= f.text_field :nickname, placeholder: "例）はやと" %></p>
  </div>

  <div class="actions">
    <%= f.submit "保存" %>
  </div>
<% end %>
