<section class="home">
  <h1>KAJILOG</h1>
  <p>
    家事を記録して、どれだけやったかを見える化するアプリです。
  </p>

  <% if user_signed_in? %>
    <div class="home-actions">
      <%= link_to "家事ログを見る", housework_logs_path, class: "btn" %>
      <%= link_to "家事を記録", new_housework_log_path, class: "btn" %>
    </div>
  <% else %>
    <div class="home-actions">
      <%= link_to "ログイン", new_user_session_path, class: "btn" %>
      <%= link_to "新規登録", new_user_registration_path, class: "btn" %>
    </div>
    <p class="home-note">
      ログインすると家事ログの登録・集計ができます。
    </p>
  <% end %>
</section>
