<% if housework_log.errors.any? %>
  <div class="form-errors">
    <p class="form-errors__title"><%= housework_log.errors.count %>件のエラーがあります</p>
    <ul>
      <% housework_log.errors.full_messages.each do |m| %>
        <li><%= m %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: housework_log, class: "form-card",
      data: {
        controller: "loading title-suggest",
        action: "submit->loading#submit",
        title_suggest_url_value: suggest_titles_housework_logs_path
      } do |f| %>

  <%# カテゴリを先に表示（カテゴリ→タイトル候補の流れ） %>
  <div class="form-group">
    <%= f.label :category, class: "form-label" %>
    <%= f.select :category,
        HouseworkLog.categories.keys.map { |k| [t("enums.housework_log.category.#{k}"), k] },
        { include_blank: "選択してください" },
        class: "form-select",
        data: {
          title_suggest_target: "categorySelect",
          action: "change->title-suggest#categoryChanged"
        } %>
  </div>

  <%# タイトル候補チップ（カテゴリ選択後に表示される） %>
  <div class="title-suggestions" data-title-suggest-target="suggestions" hidden></div>

  <div class="form-group">
    <%= f.label :title, class: "form-label" %>
    <span class="form-label-optional">任意</span>
    <%= f.text_field :title, class: "form-input",
        placeholder: "空欄ならカテゴリ名が自動セット",
        data: { title_suggest_target: "titleInput" } %>
    <p class="form-hint" data-title-suggest-target="hint" hidden>
      上の候補をタップするか、自由入力できます
    </p>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :performed_on, class: "form-label" %>
      <%= f.date_field :performed_on, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :minutes, class: "form-label" %>
      <div class="form-input-suffix">
        <%= f.number_field :minutes, min: 0, max: 1440, step: 1, class: "form-input", placeholder: "30" %>
        <span class="form-suffix">分</span>
      </div>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :memo, class: "form-label" %>
    <%= f.text_area :memo, class: "form-textarea", rows: 3, placeholder: "メモがあれば（任意）" %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary", data: { loading_target: "button" } %>
    <%= link_to "キャンセル", housework_logs_path, class: "btn btn-ghost" %>
  </div>
<% end %>
