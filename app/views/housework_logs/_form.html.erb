<% if housework_log.errors.any? %>
  <ul>
    <% housework_log.errors.full_messages.each do |m| %>
      <li><%= m %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: housework_log do |f| %>
  <%= f.label :title %><br>
  <%= f.text_field :title %><br>

  <%= f.label :category %><br>
  <%= f.number_field :category %><br>

  <%= f.label :performed_on %><br>
  <%= f.date_field :performed_on %><br>

  <%= f.label :minutes %><br>
  <%= f.number_field :minutes, min: 0, max: 1440, step: 1 %>

  <%= f.label :memo %><br>
  <%= f.text_area :memo %><br>

  <%= f.submit %>
<% end %>
