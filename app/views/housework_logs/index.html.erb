<div class="page-header">
  <h1 class="page-title">家事ログ</h1>
  <%= link_to "＋ 家事を記録", new_housework_log_path, class: "btn btn-primary btn-sm", data: { turbo_frame: "_top" } %>
</div>

<%# ---- テンプレートからワンタップ記録 ---- %>
<details class="accordion" <%= @templates.present? ? "open" : "" %>>
  <summary class="accordion__summary">
    <span>⚡ ワンタップで記録</span>
    <% if @templates.blank? %>
      <span class="accordion__sub">テンプレートを登録するとここに表示されます</span>
    <% end %>
  </summary>
  <div class="accordion__body">
    <% if @templates.present? %>
      <div class="template-buttons">
        <% @templates.each do |tmpl| %>
          <%= button_to use_housework_template_path(tmpl), method: :post,
                class: "template-tap-btn template-tap-btn--#{tmpl.category}" do %>
            <span class="template-tap-btn__icon"><%= category_icon(tmpl.category) %></span>
            <span class="template-tap-btn__title"><%= tmpl.title %></span>
            <% if tmpl.minutes.present? %>
              <span class="template-tap-btn__minutes"><%= tmpl.minutes %>分</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <p class="template-manage-link">
        <%= link_to "テンプレートを管理 →", housework_templates_path, class: "link-muted" %>
      </p>
    <% else %>
      <div class="empty-note" style="padding: 12px 0;">
        テンプレートを登録するとワンタップで記録できます。<br>
        <%= link_to "テンプレートを追加する →", new_housework_template_path %>
      </div>
    <% end %>
  </div>
</details>

<%= turbo_frame_tag "log_results" do %>

  <%# ---- ミニ統計ヘッダー ---- %>
  <% if @stats_total_count > 0 %>
    <div class="log-stats">
      <div class="log-stats__item">
        <span class="log-stats__value"><%= @stats_total_count %></span>
        <span class="log-stats__label">件</span>
      </div>
      <div class="log-stats__divider"></div>
      <div class="log-stats__item">
        <span class="log-stats__value"><%= @stats_total_minutes %></span>
        <span class="log-stats__label">分</span>
      </div>
      <% if @stats_top_category %>
        <div class="log-stats__divider"></div>
        <div class="log-stats__item">
          <span class="log-stats__value"><%= category_icon(@stats_top_category) %></span>
          <span class="log-stats__label"><%= t("enums.housework_log.category.#{@stats_top_category}") %>が最多</span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ---- 絞り込み・並び替え ---- %>
  <% filter_active = @filter.period != "all" || @filter.selected_category.present? || @filter.keyword.present? %>
  <details class="accordion" <%= (@filter.keyword.present? || filter_active) ? "open" : "" %>>
    <summary class="accordion__summary">
      <span>🔍 絞り込み・並び替え</span>
      <% if filter_active %>
        <span class="accordion__badge">適用中</span>
      <% end %>
    </summary>
    <div class="accordion__body">
      <%# キーワード検索（オートコンプリート） %>
      <div class="filter-group"
           data-controller="autocomplete"
           data-autocomplete-url-value="<%= search_titles_housework_logs_path %>">
        <p class="filter-label">キーワードで検索</p>
        <%= form_with url: housework_logs_path, method: :get, class: "filter-form autocomplete-form", data: { turbo_frame: "log_results" } do %>
          <%= hidden_field_tag :period,   @filter.period %>
          <%= hidden_field_tag :sort,     @sort %>
          <%= hidden_field_tag :category, @filter.selected_category.presence %>
          <div class="autocomplete-wrap">
            <%= text_field_tag :keyword, @filter.keyword,
                  class: "form-input",
                  placeholder: "例：掃除、洗濯",
                  autocomplete: "off",
                  data: {
                    autocomplete_target: "input",
                    action: "input->autocomplete#suggest keydown->autocomplete#keydown"
                  } %>
            <ul class="autocomplete-list"
                role="listbox"
                hidden
                data-autocomplete-target="list"></ul>
          </div>
          <%= submit_tag "検索", class: "btn btn-secondary btn-sm" %>
          <% if @filter.keyword.present? %>
            <%= link_to "解除", housework_logs_path(period: @filter.period, category: @filter.selected_category.presence, sort: @sort), class: "link-muted" %>
          <% end %>
        <% end %>
      </div>

      <div class="filter-grid">
        <div class="filter-group">
          <p class="filter-label">期間</p>
          <div class="filter-btns">
            <%= link_to "全期間", housework_logs_path(category: @filter.selected_category.presence, keyword: @filter.keyword.presence, period: "all",   sort: @sort), class: "filter-btn #{"filter-btn--active" if @filter.period == "all"}" %>
            <%= link_to "今週",   housework_logs_path(category: @filter.selected_category.presence, keyword: @filter.keyword.presence, period: "week",  sort: @sort), class: "filter-btn #{"filter-btn--active" if @filter.period == "week"}" %>
            <%= link_to "今月",   housework_logs_path(category: @filter.selected_category.presence, keyword: @filter.keyword.presence, period: "month", sort: @sort), class: "filter-btn #{"filter-btn--active" if @filter.period == "month"}" %>
          </div>
        </div>

        <div class="filter-group">
          <p class="filter-label">カテゴリ</p>
          <%= form_with url: housework_logs_path, method: :get, class: "filter-form", data: { turbo_frame: "log_results" } do %>
            <%= hidden_field_tag :period,  @filter.period %>
            <%= hidden_field_tag :sort,    @sort %>
            <%= hidden_field_tag :keyword, @filter.keyword.presence %>
            <%= select_tag :category,
                options_for_select(
                  [["すべて", ""]] + HouseworkLog.categories.keys.map { |k| [t("enums.housework_log.category.#{k}"), k] },
                  @filter.selected_category
                ), class: "form-select" %>
            <%= submit_tag "絞り込む", class: "btn btn-secondary btn-sm" %>
            <% if @filter.selected_category.present? %>
              <%= link_to "解除", housework_logs_path(period: @filter.period, keyword: @filter.keyword.presence, sort: @sort), class: "link-muted" %>
            <% end %>
          <% end %>
        </div>

        <div class="filter-group">
          <p class="filter-label">並び替え</p>
          <div class="filter-btns">
            <%= link_to "新しい順", housework_logs_path(period: @filter.period, category: @filter.selected_category.presence, keyword: @filter.keyword.presence, sort: "performed_desc"), class: "filter-btn #{"filter-btn--active" if @sort == "performed_desc"}" %>
            <%= link_to "古い順",   housework_logs_path(period: @filter.period, category: @filter.selected_category.presence, keyword: @filter.keyword.presence, sort: "performed_asc"),  class: "filter-btn #{"filter-btn--active" if @sort == "performed_asc"}" %>
          </div>
        </div>
      </div>
    </div>
  </details>

  <%# ---- ログ一覧 ---- %>
  <div class="section-header">
    <h2 class="section-title">ログ一覧</h2>
    <span class="section-meta"><%= @housework_logs.total_count %>件</span>
  </div>

  <% if @housework_logs.present? %>
    <ul class="log-list">
      <% @housework_logs.each do |log| %>
        <li class="log-item">
          <div class="log-item__main">
            <span class="badge badge--<%= log.category %>"><%= t("enums.housework_log.category.#{log.category}") %></span>
            <strong class="log-item__title"><%= log.title %></strong>
            <% if log.thanks_count > 0 %>
              <span class="log-item__thanks">💜 × <%= log.thanks_count %></span>
            <% end %>
          </div>
          <div class="log-item__meta">
            <span class="log-item__minutes"><%= log.minutes %>分</span>
            <span class="log-item__date"><%= l(log.performed_on, format: :short) %></span>
            <%= link_to "詳細", housework_log_path(log), class: "link-detail", data: { turbo_frame: "_top" } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-note">この期間の家事ログはありません。</p>
  <% end %>

  <div class="pagination">
    <%= paginate @housework_logs,
      params: { period: @filter.period, category: @filter.selected_category.presence, sort: @sort } %>
  </div>

<% end %>

<p class="page-link-bottom">
  分析は <%= link_to "ダッシュボード →", dashboard_path %>
</p>
